# FIXME: Configure environment variables for your project

# Need advanced features? Multi-tenancy & Teams, Roles & Permissions, Shadcn UI, End-to-End Typesafety with oRPC,
# Stripe Payment, Light / Dark mode. Try Next.js Boilerplate Pro: https://nextjs-boilerplate.com/pro-saas-starter-kit

# Authentication Provider Selection
# Options: 'clerk', 'cloudflare', 'cognito', 'test'
# Switch between different auth providers without code changes
# 'test' - Simple form-based auth for E2E testing (DO NOT USE IN PRODUCTION)
# For Cloudflare deployment, use 'cloudflare'
NEXT_PUBLIC_AUTH_PROVIDER=test

# Clerk authentication (used when AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmVsYXhlZC10dXJrZXktNjcuY2xlcmsuYWNjb3VudHMuZGV2JA

# Cloudflare Access (used when AUTH_PROVIDER=cloudflare)
NEXT_PUBLIC_CLOUDFLARE_AUTH_DOMAIN=https://test-team.cloudflareaccess.com
NEXT_PUBLIC_CLOUDFLARE_AUDIENCE=test-audience-tag
NEXT_PUBLIC_CLOUDFLARE_VERIFY_JWT=false  # Disable JWT verification for local testing

# AWS Cognito (used when AUTH_PROVIDER=cognito)
# NOTE: Install aws-amplify first: npm install aws-amplify
# NEXT_PUBLIC_COGNITO_REGION=us-east-1
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
#
# OAuth2 Configuration (Social Sign-In)
# NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_OAUTH_SCOPE=email,profile,openid
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/dashboard
# NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/
#
# OAuth2 Providers (enable the providers you want to use)
# NEXT_PUBLIC_COGNITO_OAUTH_GOOGLE=true
# NEXT_PUBLIC_COGNITO_OAUTH_FACEBOOK=true
# NEXT_PUBLIC_COGNITO_OAUTH_APPLE=true
#
# MFA Configuration
# NEXT_PUBLIC_COGNITO_MFA_ENABLED=true
# NEXT_PUBLIC_COGNITO_MFA_METHOD=TOTP  # TOTP (authenticator app) or SMS
# NEXT_PUBLIC_COGNITO_MFA_ISSUER=MyApp  # Name shown in authenticator app

# Monitoring & Analytics Configuration
# Enable/disable monitoring services individually
# Set to 'true' to enable, 'false' to disable

# Sentry - Error tracking and performance monitoring
# Get your DSN from https://sentry.io/
NEXT_PUBLIC_ENABLE_SENTRY=false
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# PostHog - Product analytics and feature flags
# Get your key from https://posthog.com/
NEXT_PUBLIC_ENABLE_POSTHOG=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Analytics - Privacy-friendly web analytics
# Get your token from Cloudflare Dashboard > Analytics > Web Analytics
NEXT_PUBLIC_ENABLE_CF_ANALYTICS=true
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Google Analytics (GA4) - Deprecated in favor of Cloudflare Analytics
# Get your Measurement ID from https://analytics.google.com/
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Database
# Local development: PGLite (in-memory SQLite)
# Production: Cloudflare D1 (SQLite at edge)
# For local development with D1, use: wrangler d1 execute next-boilerplate-db --local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Cloudflare D1 Database ID (get from: wrangler d1 create next-boilerplate-db)
# D1_DATABASE_ID=your-d1-database-id

# Next.js
NEXT_TELEMETRY_DISABLED=1

######## [BEGIN] SENSITIVE DATA ######## For security reason, don't update the following variables (secret key) directly in this file.
######## Please create a new file named `.env.local`, all environment files ending with `.local` won't be tracked by Git.
######## After creating the file, you can add the following variables.
# Arcjet security
# Get your key from https://launch.arcjet.com/Q6eLbRE
# ARCJET_KEY=
# ARCJET_MODE=DRY_RUN
# ARCJET_TRUSTED_PROXIES=
# ARCJET_ALLOWED_BOTS=CATEGORY:SEARCH_ENGINE,CATEGORY:PREVIEW,CATEGORY:MONITOR
# ARCJET_API_REFILL_RATE=60
# ARCJET_API_INTERVAL=60s
# ARCJET_API_CAPACITY=120
# ARCJET_API_RETRY_AFTER=60

# Clerk authentication
# CLERK_SECRET_KEY=your_clerk_secret_key  # Commented out for keyless development mode
######## [END] SENSITIVE DATA
