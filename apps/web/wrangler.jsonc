{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socialpet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets configuration
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // D1 Database binding - PRODUCTION
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "socialpet-db-production",
      "database_id": "1894c80b-52ed-4f1b-94b6-1f8059cb98b9",
      "migrations_dir": "./migrations-d1"
    }
  ],

  // Environment variables - PRODUCTION
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_AUTH_PROVIDER": "cloudflare",
    "NEXT_PUBLIC_ENVIRONMENT": "production",
    "NEXT_PUBLIC_APP_URL": "https://socialpet.io"
  },

  // Observability (2025 best practice)
  "observability": {
    "enabled": true
  },

  // Analytics Engine binding
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS"
    }
  ],

  // Logpush for production monitoring (disabled until configured)
  // "logpush": true,

  // Tail consumers for real-time logs (disabled until service exists)
  // "tail_consumers": [
  //   {
  //     "service": "socialpet-log-consumer"
  //   }
  // ],

  // Routes configuration - PRODUCTION
  // Primary domain: socialpet.io
  // Alternative: www.socialpet.io
  "routes": [
    {
      "pattern": "socialpet.io/*",
      "custom_domain": true
    },
    {
      "pattern": "www.socialpet.io/*",
      "custom_domain": true
    }
  ],

  // Environment-specific overrides
  "env": {
    // DEVELOPMENT ENVIRONMENT
    "dev": {
      "name": "socialpet-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "socialpet-db-dev",
          "database_id": "af8b36c5-ddee-4bfc-bab8-d3dfb82c80c2",
          "migrations_dir": "./migrations-d1"
        }
      ],
      "vars": {
        "NODE_ENV": "development",
        "NEXT_PUBLIC_AUTH_PROVIDER": "cloudflare",
        "NEXT_PUBLIC_ENVIRONMENT": "development",
        "NEXT_PUBLIC_APP_URL": "https://dev.socialpet.io"
      },
      "routes": [
        {
          "pattern": "dev.socialpet.io/*",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    },

    // STAGING ENVIRONMENT
    "staging": {
      "name": "socialpet-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "socialpet-db-staging",
          "database_id": "e992a2d6-cb96-4670-8ea6-5f0d940e6d73",
          "migrations_dir": "./migrations-d1"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_AUTH_PROVIDER": "cloudflare",
        "NEXT_PUBLIC_ENVIRONMENT": "staging",
        "NEXT_PUBLIC_APP_URL": "https://stg.socialpet.io"
      },
      "routes": [
        {
          "pattern": "stg.socialpet.io/*",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    },

    // TEST ENVIRONMENT
    // Dedicated environment for running integration and E2E tests
    "test": {
      "name": "socialpet-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "socialpet-db-test",
          "database_id": "e5da8a2f-e222-4e08-b315-e825b20363ec",
          "migrations_dir": "./migrations-d1"
        }
      ],
      "vars": {
        "NODE_ENV": "test",
        "NEXT_PUBLIC_AUTH_PROVIDER": "cloudflare",
        "NEXT_PUBLIC_ENVIRONMENT": "test",
        "NEXT_PUBLIC_APP_URL": "https://tst.socialpet.io"
      },
      "routes": [
        {
          "pattern": "tst.socialpet.io/*",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
