{
  "name": "web",
  "version": "1.0.0",
  "description": "Production-ready Next.js 16 boilerplate with TypeScript, Tailwind CSS, authentication, i18n, testing, and monitoring",
  "author": "Ixartz (https://github.com/ixartz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ixartz/Next-js-Boilerplate.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage .open-next",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:circular": "tsx ../../scripts/testing/check-dependencies.ts --circular",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "graph:components": "tsx ../../scripts/testing/check-dependencies.ts --graph",
    "analyze:deps": "tsx ../../scripts/testing/check-dependencies.ts",
    "commit": "commit",
    "ci:local": "run-s lint check:types test",
    "ci:full": "run-s lint check:types test:coverage test:e2e",
    "ci:check": "run-s lint check:types check:i18n check:deps test",
    "ci:build": "run-s lint check:types test build-local",
    "test": "vitest run --project unit --project ui",
    "test:coverage": "vitest run --coverage --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:inventory": "tsx ../../scripts/testing/test-inventory.ts",
    "db-server:file": "pglite-server --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:d1:generate": "drizzle-kit generate --config=drizzle.config.d1.ts",
    "db:studio": "drizzle-kit studio",
    "db:validate": "drizzle-kit check",
    "db:check-drift": "npm run db:validate",
    "db:info": "drizzle-kit introspect",
    "db:status": "echo '📊 Migration Status:' && drizzle-kit introspect",
    "db:history": "psql $DATABASE_URL -c 'SELECT * FROM _drizzle_migrations ORDER BY id DESC LIMIT 10'",
    "d1:create": "wrangler d1 create next-boilerplate-db",
    "d1:migrate": "wrangler d1 migrations apply next-boilerplate-db --local",
    "d1:migrate:stage": "wrangler d1 migrations apply next-boilerplate-db --remote --env stage",
    "d1:migrate:prod": "wrangler d1 migrations apply next-boilerplate-db --remote",
    "d1:studio": "wrangler d1 execute next-boilerplate-db --local --command 'SELECT * FROM sqlite_master'",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build",
    "db:reset:local": "rm -rf local.db && npm run db:migrate",
    "db:snapshot": "pg_dump $DATABASE_URL | gzip > backups/snapshot-$(date +%Y%m%d-%H%M%S).sql.gz",
    "db:migrate:staging": "ENVIRONMENT=staging ./scripts/db/migrate-with-telemetry.sh",
    "db:migrate:prod": "ENVIRONMENT=production ./scripts/db/migrate-with-telemetry.sh"
  },
  "dependencies": {
    "@arcjet/next": "^1.0.0-beta.13",
    "@clerk/localizations": "^3.28.0",
    "@clerk/nextjs": "^6.35.1",
    "@electric-sql/pglite": "^0.3.14",
    "@hookform/resolvers": "^5.2.2",
    "@logtape/logtape": "^1.2.0",
    "@opennextjs/cloudflare": "^1.12.0",
    "@sentry/nextjs": "^10.25.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "aws-amplify": "^6.15.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.7",
    "next": "^16.0.3",
    "next-intl": "^4.5.3",
    "pg": "^8.16.3",
    "posthog-js": "^1.292.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@chromatic-com/playwright": "^0.12.7",
    "@cloudflare/workers-types": "^4.20251115.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/prompt-cli": "^20.1.0",
    "@commitlint/types": "^20.0.0",
    "@electric-sql/pglite-socket": "^0.0.19",
    "@eslint-react/eslint-plugin": "^2.3.5",
    "@faker-js/faker": "^10.1.0",
    "@lingual/i18n-check": "^0.8.12",
    "@next/bundle-analyzer": "^16.0.3",
    "@next/eslint-plugin-next": "^16.0.3",
    "@playwright/test": "^1.56.1",
    "@spotlightjs/spotlight": "^4.5.1",
    "@storybook/addon-a11y": "^10.0.7",
    "@storybook/addon-docs": "^10.0.7",
    "@storybook/addon-vitest": "^10.0.7",
    "@storybook/nextjs-vite": "^10.0.7",
    "@storybook/test": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser": "^4.0.9",
    "@vitest/browser-playwright": "^4.0.9",
    "@vitest/coverage-v8": "^4.0.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^6.9.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.0.7",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "knip": "^5.69.1",
    "lefthook": "^2.0.4",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.0",
    "semantic-release": "^24.2.9",
    "storybook": "^10.0.7",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.9",
    "vitest-browser-react": "^2.0.2",
    "wrangler": "^4.47.0"
  },
  "overrides": {
    "@electric-sql/pglite": "^0.3.14",
    "esbuild": "^0.27.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
